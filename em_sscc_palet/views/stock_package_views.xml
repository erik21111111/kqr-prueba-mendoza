<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_package_view_form_inherit_em_sscc_palet" model="ir.ui.view">
        <field name="name">stock.package.form.inherit.em_sscc_palet</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='package_type_id']" position="before">
                <field name="sscc"/>
            </xpath>
        </field>
    </record>
    <record id="stock_package_view_list_inherit_em_sscc_palet" model="ir.ui.view">
        <field name="name">stock.package.list.inherit.em_sscc_palet</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sscc" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="stock_package_view_search_inherit_em_sscc_palet" model="ir.ui.view">
        <field name="name">stock.package.search.inherit.em_sscc_palet</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sscc"/>
            </xpath>
        </field>
    </record>
</odoo>
